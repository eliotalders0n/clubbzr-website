rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has admin role
    function isAdmin() {
      return isActiveAccount() && request.auth.token.admin == true;
    }

    // Check if user has curator role or higher
    function isCuratorOrAdmin() {
      return isActiveAccount() && (
        request.auth.token.admin == true || request.auth.token.curator == true
      );
    }

    function isActiveAccount() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          !('isActive' in currentUserData())
          || currentUserData().isActive != false
        )
        && (
          !('accountStatus' in currentUserData())
          || (
            currentUserData().accountStatus != 'frozen'
            && currentUserData().accountStatus != 'suspended'
            && currentUserData().accountStatus != 'closed'
          )
        );
    }

    // Validate that required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // A media URL other members can still fetch later. Object URLs
    // (blob:/data:) die with the tab that created them and are what put
    // broken images on the community wall, so they never belong in a document.
    function isPersistentMediaUrl(url) {
      return url is string && url.matches('https?://.*');
    }

    // Rules cannot iterate a list, so this checks the entries the feed
    // actually renders: the thumbnail and the first media item. The client
    // validates every entry before writing (lib/media.ts); this is the
    // backstop a modified or out-of-date client cannot skip.
    function hasPersistentMedia(data) {
      return (!('thumbnailUrl' in data.keys())
          || data.thumbnailUrl == null
          || isPersistentMediaUrl(data.thumbnailUrl))
        && (!('mediaUrls' in data.keys())
          || data.mediaUrls == null
          || (data.mediaUrls is list
            && (data.mediaUrls.size() == 0 || isPersistentMediaUrl(data.mediaUrls[0]))));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasSavedWhatsAppField() {
      return 'whatsappPhone' in currentUserData()
        && currentUserData().whatsappPhone is string
        && currentUserData().whatsappPhone.size() > 0;
    }

    function hasSavedLegacyPhoneField() {
      return 'phone' in currentUserData()
        && currentUserData().phone is string
        && currentUserData().phone.size() > 0;
    }

    function hasSavedWhatsAppPhone() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (hasSavedWhatsAppField() || hasSavedLegacyPhoneField());
    }

    function requestUsesSavedWhatsAppPhone() {
      return hasSavedWhatsAppPhone()
        && 'whatsappPhone' in request.resource.data
        && request.resource.data.whatsappPhone is string
        && request.resource.data.whatsappPhone.size() > 0
        && (
          (
            hasSavedWhatsAppField()
            && request.resource.data.whatsappPhone == currentUserData().whatsappPhone
          )
          || (
            !hasSavedWhatsAppField()
            && hasSavedLegacyPhoneField()
            && request.resource.data.whatsappPhone == currentUserData().phone
          )
        );
    }

    // Validate timestamp is server timestamp
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // Validate the current user is the only item added to a list field
    function currentUserAddedToList(field) {
      return resource.data[field] is list
        && request.resource.data[field] is list
        && !(request.auth.uid in resource.data[field])
        && request.auth.uid in request.resource.data[field]
        && request.resource.data[field].size() == resource.data[field].size() + 1
        && request.resource.data[field].hasAll(resource.data[field]);
    }

    // Validate the current user is the only item removed from a list field
    function currentUserRemovedFromList(field) {
      return resource.data[field] is list
        && request.resource.data[field] is list
        && request.auth.uid in resource.data[field]
        && !(request.auth.uid in request.resource.data[field])
        && request.resource.data[field].size() == resource.data[field].size() - 1
        && resource.data[field].hasAll(request.resource.data[field]);
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Authenticated members can read user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile; admins can create pending invite profiles
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.isActive == true;

      // Users can update their own profile, admins can update any
      allow update: if isActiveAccount() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'whatsappPhone', 'gender', 'bio',
          'location', 'website', 'socialLinks', 'preferences', 'isOnboarded',
          'lastActiveAt', 'lovedArtworkKeys', 'bookmarkedArtworkKeys', 'email',
          'updatedAt'
        ]);

      // Only admins can delete users
      allow delete: if false;
    }

    // ========================================
    // PUBLIC PROFILES COLLECTION
    // ========================================
    match /publicProfiles/{profileId} {
      function hasPublicProfileFieldsOnly() {
        return request.resource.data.keys().hasOnly([
          'userId',
          'displayName',
          'username',
          'photoURL',
          'bio',
          'location',
          'website',
          'interests',
          'mediums',
          'hasArtistProfile',
          'artistName',
          'postsCount',
          'followersCount',
          'worksCount',
          'questsCompletedCount',
          'badgesCount',
          'eventsAttendedCount',
          'createdAt',
          'updatedAt'
        ]);
      }

      function isValidPublicProfileWrite() {
        return request.resource.data.userId == profileId
          && request.resource.data.displayName is string
          && request.resource.data.username is string
          && request.resource.data.interests is list
          && (!('mediums' in request.resource.data) || request.resource.data.mediums is list);
      }

      allow read: if true;
      allow create, update: if isAdmin() || (
        isOwner(profileId)
        && hasPublicProfileFieldsOnly()
        && isValidPublicProfileWrite()
      );
      allow delete: if isAdmin();
    }

    // ========================================
    // ARTISTS COLLECTION
    // ========================================
    match /artists/{artistId} {
      // Anyone can read artist profiles
      allow read: if true;

      // Authenticated users can create artist profiles
      allow create: if isActiveAccount();

      // Artist owner or admin can update profile data.
      // Authenticated users can only update follow counters.
      allow update: if isOwner(resource.data.userId) || isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
      );

      // Only admin can delete
      allow delete: if isAdmin();
    }

    // ========================================
    // ARTIST FOLLOWS COLLECTION
    // ========================================
    match /artistFollows/{followId} {
      // Authenticated users can read follow relationships
      allow read: if isAuthenticated();

      // Users can create their own follow records
      allow create: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.artistId is string;

      // Follow records are immutable; delete/recreate to change state
      allow update: if false;

      // Users can delete their own follow records
      allow delete: if isActiveAccount() && resource.data.userId == request.auth.uid;
    }

    // ========================================
    // ARTWORKS COLLECTION
    // ========================================
    match /artworks/{artworkId} {
      // Public artwork discovery
      allow read: if true;

      // Artists can create their own artwork documents
      allow create: if isActiveAccount()
        && exists(/databases/$(database)/documents/artists/$(request.auth.uid))
        && request.resource.data.artistId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.imageUrl is string;

      // Artwork owners or admins can update artwork without reassigning ownership
      allow update: if isActiveAccount()
        && (resource.data.artistId == request.auth.uid || isAdmin())
        && request.resource.data.artistId == resource.data.artistId;

      // Artwork owners or admins can delete artwork
      allow delete: if isActiveAccount()
        && (resource.data.artistId == request.auth.uid || isAdmin());
    }

    // ========================================
    // SESSIONS COLLECTION
    // ========================================
    match /sessions/{sessionId} {
      // Anyone can read sessions
      allow read: if true;

      // Only curators and admins can create/update/delete sessions
      allow create, update, delete: if isCuratorOrAdmin();

      // Signed-in users can only register or cancel their own registration
      allow update: if isActiveAccount()
        && resource.data.status == 'published'
        && isServerTimestamp('updatedAt')
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'updatedAt'])
            && (
              (
                currentUserAddedToList('attendees')
                && hasSavedWhatsAppPhone()
                && request.resource.data.attendees.size() <= resource.data.capacity
              )
              || currentUserRemovedFromList('attendees')
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitlist', 'updatedAt'])
            && (
              (
                currentUserAddedToList('waitlist')
                && hasSavedWhatsAppPhone()
              )
              || currentUserRemovedFromList('waitlist')
            )
          )
        );
    }

    // ========================================
    // SESSION REGISTRATIONS COLLECTION
    // ========================================
    match /sessionRegistrations/{registrationId} {
      function registrationSession() {
        return get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
      }

      function canCreateSelfRegistration() {
        return isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && requestUsesSavedWhatsAppPhone()
          && hasRequiredFields(['sessionId', 'userId', 'displayName', 'email', 'status', 'paymentStatus', 'requestedAt', 'createdAt'])
          && registrationSession().status == 'published'
          && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
          && request.resource.data.status in ['requested', 'pending_payment', 'waitlisted', 'confirmed']
          && request.resource.data.paymentStatus in ['not_required', 'unpaid']
          && (
            request.resource.data.status != 'confirmed'
            || (
              registrationSession().isFree == true
              && (!('approvalMode' in registrationSession()) || registrationSession().approvalMode == 'auto')
              && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
            )
          );
      }

      function canCancelSelfRegistration() {
        return isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid;
      }

      function canResubmitSelfRegistration() {
        return isOwner(resource.data.userId)
          && requestUsesSavedWhatsAppPhone()
          && resource.data.status in ['cancelled', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'email',
            'phone',
            'whatsappPhone',
            'photoURL',
            'status',
            'paymentStatus',
            'requestedAt',
            'updatedAt'
          ])
          && request.resource.data.status in ['requested', 'pending_payment', 'waitlisted', 'confirmed']
          && request.resource.data.paymentStatus in ['not_required', 'unpaid']
          && (
            request.resource.data.status != 'confirmed'
            || (
              registrationSession().isFree == true
              && (!('approvalMode' in registrationSession()) || registrationSession().approvalMode == 'auto')
              && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
            )
          );
      }

      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || canCreateSelfRegistration();
      allow update: if isAdmin() || canCancelSelfRegistration() || canResubmitSelfRegistration();
      allow delete: if isAdmin();
    }

    // ========================================
    // QUESTS COLLECTION
    // ========================================
    match /quests/{questId} {
      // Anyone can read quests
      allow read: if true;

      // Only admins can create/update/delete quests
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // QUEST SUBMISSIONS COLLECTION
    // ========================================
    match /questSubmissions/{submissionId} {
      // Anyone can read submissions
      allow read: if true;

      // Authenticated users can create submissions, as long as any media they
      // reference will still load for every other member.
      allow create: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.pointsAwarded == 0
        && hasPersistentMedia(request.resource.data);

      // Users can update their own submissions, admins can update any.
      // Any authenticated member can update only the aggregate vote fields.
      allow update: if isActiveAccount() &&
        hasPersistentMedia(request.resource.data) && (
        (
          isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'content', 'mediaUrls', 'mediaType', 'thumbnailUrl', 'updatedAt'
          ])
        ) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'upvotes',
          'downvotes',
          'upvotesCount',
          'downvotesCount',
          'voteScore',
          'updatedAt'
        ])
      );

      // Users can delete their own, admins can delete any
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ========================================
    // COMMUNITY POSTS COLLECTION
    // ========================================
    match /communityPosts/{postId} {
      // Anyone can read posts (that aren't hidden)
      allow read: if true;

      // Authenticated members can create only their own member posts. Platform
      // notes are written by trusted server code through the Admin SDK.
      allow create: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid &&
        hasPersistentMedia(request.resource.data) &&
        !request.resource.data.keys().hasAny(['postType', 'communityNote', 'marketplace']);

      // Post author can update their own posts, admins can update any
      // Also allow updates for reactions/comments counters
      allow update: if isActiveAccount() &&
        hasPersistentMedia(request.resource.data) && (
        (isOwner(resource.data.userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'postType', 'communityNote', 'marketplace'
          ])) ||
        isAdmin() ||
        // Allow anyone to update reaction/comment fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions', 'reactionsCount', 'comments', 'commentsCount', 'shares', 'updatedAt'
        ])
      );

      // Post author or admin can delete
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ========================================
    // COMMENTS COLLECTION
    // ========================================
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;

      // Authenticated users can create comments
      allow create: if isActiveAccount();

      // Comment author can update, admins can update any
      // Allow reaction updates from anyone
      allow update: if isActiveAccount() && (
        isOwner(resource.data.userId) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions', 'reactionsCount', 'repliesCount', 'updatedAt'
        ])
      );

      // Comment author or admin can delete
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ========================================
    // EXHIBITIONS COLLECTION
    // ========================================
    match /exhibitions/{exhibitionId} {
      // Anyone can read exhibitions
      allow read: if true;

      // Only curators and admins can manage exhibitions
      allow create, update, delete: if isCuratorOrAdmin();

      // Allow view count increments from anyone
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'updatedAt']);
    }

    // ========================================
    // ART LOCATIONS COLLECTION
    // ========================================
    match /artLocations/{locationId} {
      // Anyone can read locations
      allow read: if true;

      // Authenticated users can create locations
      allow create: if isActiveAccount();

      // Creator or admin can update
      allow update: if isActiveAccount() && (
        isOwner(resource.data.submittedBy) ||
        isAdmin() ||
        // Allow save/visit toggles
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'savedBy', 'visitedBy', 'savesCount', 'visitsCount'
        ])
      );

      // Creator or admin can delete
      allow delete: if isOwner(resource.data.submittedBy) || isAdmin();
    }

    // ========================================
    // RADIO CONTENT COLLECTION
    // ========================================
    match /radioContent/{contentId} {
      // Anyone can read radio content
      allow read: if true;

      // Only admins can create/delete
      allow create, delete: if isAdmin();

      // Admins can fully update, others can only update play/like counts
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'playCount', 'likedBy', 'likesCount', 'updatedAt'
        ])
      );
    }

    // ========================================
    // CREATIVE PASSPORTS COLLECTION
    // ========================================
    match /creativePassports/{passportId} {
      // Users can read their own passport, admins can read any
      allow read: if isOwner(passportId) || isAdmin();

      // Users can create/update their own passport
      allow create: if isOwner(passportId)
        && request.resource.data.userId == passportId
        && request.resource.data.points == 0
        && request.resource.data.level == 1
        && request.resource.data.badges.size() == 0
        && request.resource.data.questsCompleted.size() == 0
        && request.resource.data.eventsAttended.size() == 0;

      // Points, XP, badges, progress, streaks, timeline and statistics are
      // authoritative server projections. Members may edit profile interests.
      allow update: if isOwner(passportId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mediums', 'interests', 'updatedAt'
        ]);

      // Only admins can delete passports
      allow delete: if false;
    }

    // ========================================
    // MATCHES COLLECTION
    // ========================================
    match /matches/{matchId} {
      // Users can read matches where they are involved
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.matchedUserId == request.auth.uid
      );

      // System creates matches (via cloud functions ideally)
      // For now, allow authenticated users to create
      allow create: if isActiveAccount();

      // Users involved in the match can update status
      allow update: if isActiveAccount() && (
        resource.data.userId == request.auth.uid ||
        resource.data.matchedUserId == request.auth.uid
      );

      // Only admins can delete matches
      allow delete: if isAdmin();
    }

    // ========================================
    // NOTIFICATIONS COLLECTION
    // ========================================
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(resource.data.userId);

      // System creates notifications
      allow create: if false;

      // Users can mark their notifications as read
      allow update: if isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;

      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId);
    }

    // ========================================
    // AUTHORITATIVE ECONOMY COLLECTIONS
    // ========================================
    // Marketplace metadata is public only while published and enabled.
    function storeVisible() {
      return exists(/databases/$(database)/documents/settings/store)
        && get(/databases/$(database)/documents/settings/store).data.storeEnabled == true;
    }
    function storeSellerActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('isActive', true) != false
        && !(get(/databases/$(database)/documents/users/$(uid)).data.get('accountStatus', 'active') in ['suspended', 'closed']);
    }
    match /storeListings/{listingId} {
      allow read: if isAdmin() || isOwner(resource.data.sellerId) || (
        storeVisible() && resource.data.status == 'published'
        && storeSellerActive(resource.data.sellerId)
        && (resource.data.productType != 'physical_original' || get(/databases/$(database)/documents/settings/store).data.physicalProductsEnabled == true)
        && (resource.data.productType != 'gated_collection' || get(/databases/$(database)/documents/settings/store).data.gatedCollectionsEnabled == true)
      );
      allow write: if false;
    }
    match /storeSellerProfiles/{sellerId} {
      allow read: if isAdmin() || isOwner(sellerId) || (storeVisible() && storeSellerActive(sellerId));
      allow write: if false;
    }
    match /storeSellerAccounts/{sellerId} {
      allow read: if isAdmin() || isOwner(sellerId);
      allow write: if false;
    }
    match /sellerPayables/{sellerId} {
      allow read: if isAdmin() || isOwner(sellerId);
      allow write: if false;
    }
    match /storeGrants/{grantId} {
      allow read: if isAdmin() || isOwner(resource.data.buyerId);
      allow write: if false;
    }
    match /storePayouts/{payoutId} {
      allow read: if isAdmin() || isOwner(resource.data.sellerId);
      allow write: if false;
    }
    match /storeOrderEvents/{eventId} {
      allow read: if isAdmin() || (isActiveAccount() && request.auth.uid in resource.data.participants);
      allow write: if false;
    }
    match /storeOrderMessages/{messageId} {
      allow read: if isAdmin() || (isActiveAccount() && request.auth.uid in resource.data.participants);
      allow write: if false;
    }
    match /storeListingAssets/{assetId} { allow read, write: if false; }
    match /storeOperations/{operationId} { allow read, write: if false; }
    match /storeDownloadAttempts/{attemptId} { allow read, write: if false; }
    match /storeRefundReceipts/{receiptId} { allow read: if isAdmin(); allow write: if false; }

    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow write: if false;
    }

    match /balances/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || (
        isAuthenticated() && request.auth.uid in resource.data.participants
      );
      allow write: if false;
    }

    match /ledgerEntries/{entryId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.accountId == request.auth.uid
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sessionExternalPaymentReceipts/{receiptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sessionExternalFundMovements/{movementId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /trades/{tradeId} {
      allow read: if isAdmin() || (
        isAuthenticated() && request.auth.uid in resource.data.participants
      );
      allow write: if false;
    }

    match /escrows/{escrowId} {
      allow read: if isAdmin() || (
        isAuthenticated() && request.auth.uid in resource.data.participants
      );
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /walletUsage/{usageId} {
      allow read, write: if false;
    }

    match /userInvites/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /questProgress/{progressId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false;
    }

    match /rewardGrants/{grantId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false;
    }

    match /activity/{activityId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false;
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reconciliationIssues/{issueId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fraudAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /systemState/{stateId} {
      allow read, write: if false;
    }

    // ========================================
    // MAIL QUEUE COLLECTION
    // ========================================
    match /mail/{mailId} {
      // Cloud Functions writes mail jobs with Admin SDK. Clients should not read
      // queued email payloads or write arbitrary outbound mail.
      allow read, write: if false;
    }

    // ========================================
    // OUTBOUND MESSAGE LEDGER COLLECTIONS
    // ========================================
    match /messageJobs/{messageJobId} {
      // Cloud Functions writes outbound WhatsApp/message jobs with Admin SDK.
      // Clients should not read private contact payloads or spoof delivery jobs.
      allow read, write: if false;
    }

    match /whatsappWebhookEvents/{eventId} {
      // Raw Meta webhook payloads are private operational logs.
      allow read, write: if false;
    }

    // ========================================
    // PROMPTS COLLECTION
    // ========================================
    match /prompts/{promptId} {
      // Anyone can read prompts
      allow read: if true;

      // Only admins can manage prompts
      allow create, update, delete: if isAdmin();
    }

    // ========================================
    // SESSION REGISTRATIONS SUBCOLLECTION
    // ========================================
    match /sessions/{sessionId}/registrations/{registrationId} {
      // Anyone can read registrations
      allow read: if true;

      // Users can create their own registration
      allow create: if isActiveAccount() && request.auth.uid == registrationId;

      // Users can update/delete their own registration
      allow update, delete: if isOwner(registrationId) || isAdmin();
    }
  }
}
