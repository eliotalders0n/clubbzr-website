# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Emulators (for local development)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# App Configuration
VITE_APP_NAME=CLUB BZR
VITE_APP_URL=http://localhost:3000

# Firebase Functions
# Put these in functions/.env for deployed Cloud Functions.
APP_BASE_URL=https://club-bzr.web.app
ADMIN_PAYMENT_SUCCESS_WHATSAPP_NUMBERS=260971234567,260961234567
WHATSAPP_PAYMENT_SUCCESS_ADMIN_TEMPLATE_NAME=session_payment_success_admin_v1
# OpenStreetMap tile configuration.
# The default in-app URL is https://tile.openstreetmap.org/{z}/{x}/{y}.png.
# For higher production traffic, set this to an OSM-derived provider that
# matches your expected volume and update the attribution to its requirement.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Location search. Put this in functions/.env. The backend defaults to the
# public Nominatim endpoint and can be switched without rebuilding the client.
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
