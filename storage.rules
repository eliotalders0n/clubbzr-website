rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Older profiles may omit these optional account-status fields.
    function isActiveUser(user) {
      return (!('isActive' in user) || user.isActive != false)
        && (!('accountStatus' in user)
          || (user.accountStatus != 'suspended' && user.accountStatus != 'closed'));
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && isActiveUser(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data);
    }

    // Helper function to check file size (max 10MB)
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Helper function to check audio file size (max 50MB)
    function isValidAudioSize() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // Helper function to check if file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Helper function to check if file is a video
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // Helper function to check if file is audio
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    // Helper function to check if the signed-in user can manage admin media
    function isCuratorOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || request.auth.token.curator == true
      );
    }

    // Community posts media
    match /community/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (isImage() || isVideo());
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidSize() && isImage();
    }

    // Artist portfolios
    match /portfolios/{artistId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (isImage() || isVideo());
    }

    // Exhibition media
    match /exhibitions/{exhibitionId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (isImage() || isVideo() || isAudio());
    }

    // Session/Event covers
    match /sessions/covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidSize() && isImage();
    }

    // Session/Event gallery images
    match /sessions/gallery/{userId}/{fileName} {
      allow read: if true;
      allow write: if isCuratorOrAdmin()
        && request.auth.uid == userId
        && isValidSize()
        && isImage();
    }

    match /sessions/{sessionId}/{fileName} {
      allow read: if true;
      allow write: if isCuratorOrAdmin() && isValidSize() && isImage();
    }

    // Quest media
    match /quests/{questId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidSize() && (isImage() || isVideo());
    }

    // Radio content
    match /radio/{fileName} {
      allow read: if true;
      allow write: if isCuratorOrAdmin() && isValidAudioSize() && isAudio();
    }

    // Paid assets have no public download tokens. Only signed server requests
    // can upload/read these immutable objects; no client Storage SDK access.
    match /store-private/{allPaths=**} { allow read, write: if false; }
    match /store-previews/{userId}/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidSize()
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
    }
    // Preserve existing public media while excluding the protected namespace.
    match /{folder}/{allPaths=**} {
      allow read: if folder != 'store-private';
      allow write: if false;
    }
  }
}
