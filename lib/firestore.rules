rules_version = '2';

/**
 * Firestore Security Rules
 * Club BZR - Experimental Art Community
 *
 * Role hierarchy: admin > curator/facilitator > artist > user
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // HELPER FUNCTIONS
    // ==========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get current user's ID
    function userId() {
      return request.auth.uid;
    }

    // Check if user owns the resource
    function isOwner(resourceUserId) {
      return isAuthenticated() && userId() == resourceUserId;
    }

    // Get user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(userId())).data;
    }

    // Check user role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Check if user has any of the specified roles
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserData().role in roles;
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Check if user is curator
    function isCurator() {
      return hasAnyRole(['admin', 'curator']);
    }

    // Check if user is facilitator
    function isFacilitator() {
      return hasAnyRole(['admin', 'curator', 'facilitator']);
    }

    // Check if user is artist
    function isArtist() {
      return hasAnyRole(['admin', 'curator', 'facilitator', 'artist']);
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate field is not changed
    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Validate timestamp is server timestamp
    function isServerTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // Validate string length
    function isValidStringLength(field, min, max) {
      let value = request.resource.data[field];
      return value is string && value.size() >= min && value.size() <= max;
    }

    function hasUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(userId()));
    }

    function hasSavedWhatsAppField() {
      return 'whatsappPhone' in getUserData()
        && getUserData().whatsappPhone is string
        && getUserData().whatsappPhone.size() > 0;
    }

    function hasSavedLegacyPhoneField() {
      return 'phone' in getUserData()
        && getUserData().phone is string
        && getUserData().phone.size() > 0;
    }

    function hasSavedWhatsAppPhone() {
      return hasUserDoc()
        && (hasSavedWhatsAppField() || hasSavedLegacyPhoneField());
    }

    function requestUsesSavedWhatsAppPhone() {
      return hasSavedWhatsAppPhone()
        && 'whatsappPhone' in request.resource.data
        && request.resource.data.whatsappPhone is string
        && request.resource.data.whatsappPhone.size() > 0
        && (
          (
            hasSavedWhatsAppField()
            && request.resource.data.whatsappPhone == getUserData().whatsappPhone
          )
          || (
            !hasSavedWhatsAppField()
            && hasSavedLegacyPhoneField()
            && request.resource.data.whatsappPhone == getUserData().phone
          )
        );
    }

    // Validate the current user is the only item added to a list field
    function currentUserAddedToList(field) {
      return resource.data[field] is list
        && request.resource.data[field] is list
        && !(userId() in resource.data[field])
        && userId() in request.resource.data[field]
        && request.resource.data[field].size() == resource.data[field].size() + 1
        && request.resource.data[field].hasAll(resource.data[field]);
    }

    // Validate the current user is the only item removed from a list field
    function currentUserRemovedFromList(field) {
      return resource.data[field] is list
        && request.resource.data[field] is list
        && userId() in resource.data[field]
        && !(userId() in request.resource.data[field])
        && request.resource.data[field].size() == resource.data[field].size() - 1
        && resource.data[field].hasAll(request.resource.data[field]);
    }

    // ==========================================================================
    // USERS COLLECTION
    // ==========================================================================

    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Users can create their own profile on signup; admins can create pending invite profiles
      allow create: if isAdmin() || (isOwner(userId)
        && hasRequiredFields(['uid', 'email', 'displayName', 'role', 'isOnboarded', 'isActive', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'); // New users start as 'user' role

      // Users can update their own profile; admins can manage profiles and roles
      allow update: if isAdmin() || (isOwner(userId)
        && fieldUnchanged('uid')
        && fieldUnchanged('email') // Email change requires auth operation
        && fieldUnchanged('createdAt')
        && fieldUnchanged('role'));

      // Users can delete their own account
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ==========================================================================
    // PUBLIC PROFILES COLLECTION
    // ==========================================================================

    match /publicProfiles/{profileId} {
      function hasPublicProfileFieldsOnly() {
        return request.resource.data.keys().hasOnly([
          'userId',
          'displayName',
          'username',
          'photoURL',
          'bio',
          'location',
          'website',
          'interests',
          'mediums',
          'hasArtistProfile',
          'artistName',
          'postsCount',
          'followersCount',
          'worksCount',
          'questsCompletedCount',
          'badgesCount',
          'eventsAttendedCount',
          'createdAt',
          'updatedAt'
        ]);
      }

      function isValidPublicProfileWrite() {
        return request.resource.data.userId == profileId
          && request.resource.data.displayName is string
          && request.resource.data.username is string
          && request.resource.data.interests is list
          && (!('mediums' in request.resource.data) || request.resource.data.mediums is list);
      }

      allow read: if true;
      allow create, update: if isAdmin() || (
        isOwner(profileId)
        && hasPublicProfileFieldsOnly()
        && isValidPublicProfileWrite()
      );
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // CREATIVE PASSPORTS COLLECTION
    // ==========================================================================

    match /creativePassports/{passportId} {
      // Anyone authenticated can read passports
      allow read: if isAuthenticated();

      // Passport is created with user ID as doc ID
      allow create: if isOwner(passportId)
        && hasRequiredFields(['userId', 'createdAt'])
        && request.resource.data.userId == passportId;

      // Users can update their own passport
      allow update: if isOwner(resource.data.userId)
        && fieldUnchanged('userId')
        && fieldUnchanged('createdAt');

      // Users can delete their own passport
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ==========================================================================
    // ARTISTS COLLECTION
    // ==========================================================================

    match /artists/{artistId} {
      // Anyone can read artist profiles
      allow read: if true;

      // Users can create artist profile for themselves
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'name', 'createdAt'])
        && request.resource.data.userId == userId()
        && request.resource.data.featured == false
        && request.resource.data.verified == false;

      // Artists can update their own profile (not featured/verified status)
      allow update: if isOwner(resource.data.userId)
        && fieldUnchanged('userId')
        && fieldUnchanged('createdAt')
        && (fieldUnchanged('featured') || isCurator())
        && (fieldUnchanged('verified') || isAdmin());

      // Only admin can delete artist profiles
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ==========================================================================
    // SESSIONS (EVENTS) COLLECTION
    // ==========================================================================

    match /sessions/{sessionId} {
      // Anyone can read published sessions
      allow read: if resource.data.status == 'published'
        || isOwner(resource.data.facilitator.userId)
        || isFacilitator();

      // Facilitators can create sessions
      allow create: if isFacilitator()
        && hasRequiredFields(['title', 'description', 'type', 'date', 'status', 'createdAt'])
        && request.resource.data.facilitator.userId == userId();

      // Facilitators can update their own sessions, or admin can update any
      allow update: if (isOwner(resource.data.facilitator.userId) || isAdmin())
        && fieldUnchanged('createdAt')
        && fieldUnchanged('facilitator.userId');

      // Signed-in users can only register or cancel their own registration
      allow update: if isAuthenticated()
        && resource.data.status == 'published'
        && isServerTimestamp('updatedAt')
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'updatedAt'])
            && (
              (
                currentUserAddedToList('attendees')
                && hasSavedWhatsAppPhone()
                && request.resource.data.attendees.size() <= resource.data.capacity
              )
              || currentUserRemovedFromList('attendees')
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitlist', 'updatedAt'])
            && (
              (
                currentUserAddedToList('waitlist')
                && hasSavedWhatsAppPhone()
              )
              || currentUserRemovedFromList('waitlist')
            )
          )
        );

      // Only session owner or admin can delete
      allow delete: if isOwner(resource.data.facilitator.userId) || isAdmin();

      // Subcollection for session attendees
      match /attendees/{attendeeId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(attendeeId);
        allow delete: if isOwner(attendeeId) || isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.facilitator.userId);
      }
    }

    // ==========================================================================
    // SESSION REGISTRATIONS COLLECTION
    // ==========================================================================

    match /sessionRegistrations/{registrationId} {
      function registrationSession() {
        return get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data;
      }

      function canCreateSelfRegistration() {
        return isAuthenticated()
          && request.resource.data.userId == userId()
          && requestUsesSavedWhatsAppPhone()
          && hasRequiredFields(['sessionId', 'userId', 'displayName', 'email', 'status', 'paymentStatus', 'requestedAt', 'createdAt'])
          && registrationSession().status == 'published'
          && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
          && request.resource.data.status in ['requested', 'pending_payment', 'waitlisted', 'confirmed']
          && request.resource.data.paymentStatus in ['not_required', 'unpaid']
          && (
            request.resource.data.status != 'confirmed'
            || (
              registrationSession().isFree == true
              && (!('approvalMode' in registrationSession()) || registrationSession().approvalMode == 'auto')
              && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
            )
          );
      }

      function canCancelSelfRegistration() {
        return isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == userId();
      }

      function canResubmitSelfRegistration() {
        return isOwner(resource.data.userId)
          && requestUsesSavedWhatsAppPhone()
          && resource.data.status in ['cancelled', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'email',
            'phone',
            'whatsappPhone',
            'photoURL',
            'status',
            'paymentStatus',
            'requestedAt',
            'updatedAt'
          ])
          && request.resource.data.status in ['requested', 'pending_payment', 'waitlisted', 'confirmed']
          && request.resource.data.paymentStatus in ['not_required', 'unpaid']
          && (
            request.resource.data.status != 'confirmed'
            || (
              registrationSession().isFree == true
              && (!('approvalMode' in registrationSession()) || registrationSession().approvalMode == 'auto')
              && (!('accessMode' in registrationSession()) || registrationSession().accessMode == 'open')
            )
          );
      }

      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin() || canCreateSelfRegistration();
      allow update: if isAdmin() || canCancelSelfRegistration() || canResubmitSelfRegistration();
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // ARTWORKS COLLECTION
    // ==========================================================================

    match /artworks/{artworkId} {
      // Anyone can read public artwork
      allow read: if true;

      // Artists can create their own artwork documents
      allow create: if isAuthenticated()
        && exists(/databases/$(database)/documents/artists/$(request.auth.uid))
        && request.resource.data.artistId == userId()
        && request.resource.data.title is string
        && request.resource.data.imageUrl is string;

      // Artwork owners or admins can update artwork without reassigning ownership
      allow update: if isAuthenticated()
        && (resource.data.artistId == userId() || isAdmin())
        && request.resource.data.artistId == resource.data.artistId;

      // Artwork owners or admins can delete artwork
      allow delete: if isAuthenticated()
        && (resource.data.artistId == userId() || isAdmin());
    }

    // ==========================================================================
    // QUESTS COLLECTION
    // ==========================================================================

    match /quests/{questId} {
      // Anyone can read active quests
      allow read: if resource.data.isActive == true || isFacilitator();

      // Facilitators and above can create quests
      allow create: if isFacilitator()
        && hasRequiredFields(['title', 'description', 'category', 'difficulty', 'isActive', 'createdAt'])
        && request.resource.data.createdBy == userId();

      // Quest creator or admin can update
      allow update: if (isOwner(resource.data.createdBy) || isAdmin())
        && fieldUnchanged('createdAt')
        && fieldUnchanged('createdBy');

      // Only admin can delete quests
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // QUEST SUBMISSIONS COLLECTION
    // ==========================================================================

    match /questSubmissions/{submissionId} {
      // Anyone authenticated can read approved submissions
      allow read: if isAuthenticated()
        && (resource.data.approved == true || isOwner(resource.data.userId) || isFacilitator());

      // Users can create submissions
      allow create: if isAuthenticated()
        && hasRequiredFields(['questId', 'userId', 'content', 'createdAt'])
        && request.resource.data.userId == userId()
        && request.resource.data.approved == false
        && request.resource.data.featured == false;

      // Users can update their own submissions (not approved/featured).
      // Any authenticated member can update only aggregate vote fields.
      allow update: if (
        isOwner(resource.data.userId)
          && fieldUnchanged('questId')
          && fieldUnchanged('userId')
          && fieldUnchanged('createdAt')
          && (fieldUnchanged('approved') || isFacilitator())
          && (fieldUnchanged('featured') || isCurator())
      ) || (
        isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'upvotes',
            'downvotes',
            'upvotesCount',
            'downvotesCount',
            'voteScore',
            'updatedAt'
          ])
      );

      // Users can delete their own submissions
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ==========================================================================
    // COMMUNITY POSTS COLLECTION
    // ==========================================================================

    match /communityPosts/{postId} {
      // Anyone authenticated can read approved/non-hidden posts
      allow read: if isAuthenticated()
        && (resource.data.isHidden == false || isOwner(resource.data.userId) || isAdmin());

      // Users can create posts
      allow create: if isAuthenticated()
        && hasRequiredFields(['userId', 'content', 'createdAt'])
        && request.resource.data.userId == userId()
        && request.resource.data.isApproved == true // Auto-approve by default
        && request.resource.data.isHidden == false
        && request.resource.data.featured == false
        && request.resource.data.pinned == false;

      // Users can update their own posts (not admin fields), admins can moderate any post
      allow update: if (isOwner(resource.data.userId) || isAdmin())
        && fieldUnchanged('userId')
        && fieldUnchanged('createdAt')
        && (fieldUnchanged('isApproved') || isAdmin())
        && (fieldUnchanged('isHidden') || isAdmin())
        && (fieldUnchanged('featured') || isCurator())
        && (fieldUnchanged('pinned') || isAdmin());

      // Authenticated users can update interaction-only fields
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions', 'reactionsCount', 'commentsCount', 'shares', 'updatedAt'
        ]);

      // Users can delete their own posts
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ==========================================================================
    // COMMENTS COLLECTION
    // ==========================================================================

    match /comments/{commentId} {
      // Anyone authenticated can read comments
      allow read: if isAuthenticated();

      // Users can create comments
      allow create: if isAuthenticated()
        && hasRequiredFields(['parentId', 'parentType', 'userId', 'content', 'createdAt'])
        && request.resource.data.userId == userId();

      // Users can update their own comments
      allow update: if isOwner(resource.data.userId)
        && fieldUnchanged('parentId')
        && fieldUnchanged('parentType')
        && fieldUnchanged('userId')
        && fieldUnchanged('createdAt');

      // Authenticated users can update comment interaction-only fields
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions', 'reactionsCount', 'repliesCount', 'updatedAt'
        ]);

      // Users can delete their own comments
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ==========================================================================
    // EXHIBITIONS COLLECTION
    // ==========================================================================

    match /exhibitions/{exhibitionId} {
      // Anyone can read exhibitions
      allow read: if true;

      // Curators can create exhibitions
      allow create: if isCurator()
        && hasRequiredFields(['title', 'description', 'curator', 'startDate', 'endDate', 'createdAt'])
        && request.resource.data.curator.userId == userId();

      // Exhibition curator or admin can update
      allow update: if (isOwner(resource.data.curator.userId) || isAdmin())
        && fieldUnchanged('createdAt')
        && fieldUnchanged('curator.userId');

      // Allow public view count increments
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'viewsCount', 'updatedAt'
      ]);

      // Only admin can delete exhibitions
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // ART LOCATIONS COLLECTION
    // ==========================================================================

    match /artLocations/{locationId} {
      // Anyone can read verified locations
      allow read: if resource.data.verified == true || isOwner(resource.data.submittedBy) || isCurator();

      // Users can submit locations; curators/admins can create managed locations
      allow create: if (
          isAuthenticated()
          && hasRequiredFields(['name', 'type', 'coordinates', 'address', 'city', 'country', 'description', 'submittedBy', 'createdAt'])
          && request.resource.data.submittedBy == userId()
          && request.resource.data.verified == false
          && request.resource.data.featured == false
        ) || (
          isCurator()
          && hasRequiredFields(['name', 'type', 'coordinates', 'address', 'city', 'country', 'description', 'submittedBy', 'createdAt'])
        );

      // Users can update their own submissions; curators/admins can verify and manage
      allow update: if (isOwner(resource.data.submittedBy) || isCurator())
        && fieldUnchanged('submittedBy')
        && fieldUnchanged('createdAt')
        && (fieldUnchanged('verified') || isCurator())
        && (fieldUnchanged('featured') || isCurator());

      // Only admin can delete locations
      allow delete: if isOwner(resource.data.submittedBy) || isAdmin();
    }

    // ==========================================================================
    // RADIO CONTENT COLLECTION
    // ==========================================================================

    match /radioContent/{contentId} {
      // Anyone can read published content
      allow read: if resource.data.isPublished == true || isCurator();

      // Curators can create radio content
      allow create: if isCurator()
        && hasRequiredFields(['title', 'type', 'audioUrl', 'description', 'createdAt']);

      // Curators can update radio content
      allow update: if (
          isCurator()
          && fieldUnchanged('createdAt')
        ) || (
          isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'playCount', 'likedBy', 'likesCount', 'updatedAt'
          ])
        );

      // Only admin can delete radio content
      allow delete: if isAdmin();
    }

    // ==========================================================================
    // NOTIFICATIONS COLLECTION
    // ==========================================================================

    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(resource.data.userId);

      // System creates notifications (via Cloud Functions typically)
      // For client-side, users can create notifications for themselves
      allow create: if isAuthenticated()
        && request.resource.data.userId == userId();

      // Users can mark their own notifications as read
      allow update: if isOwner(resource.data.userId)
        && fieldUnchanged('userId')
        && fieldUnchanged('type')
        && fieldUnchanged('title')
        && fieldUnchanged('body')
        && fieldUnchanged('createdAt');

      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId);
    }

    // ==========================================================================
    // MAIL QUEUE COLLECTION
    // ==========================================================================

    match /mail/{mailId} {
      // Cloud Functions writes mail jobs with Admin SDK. Clients should not read
      // queued email payloads or write arbitrary outbound mail.
      allow read, write: if false;
    }

    // ==========================================================================
    // CATCH-ALL: DENY ACCESS TO UNDEFINED COLLECTIONS
    // ==========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
