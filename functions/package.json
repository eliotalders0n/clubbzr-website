{
  "name": "functions",
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "migrate:economy:dry-run": "node scripts/migrate-economy.cjs",
    "migrate:economy": "node scripts/migrate-economy.cjs --apply",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:store:emulator": "npm run build && node --test --test-concurrency=1 test/store.emulator.cjs",
    "seed:store": "npm run build && node scripts/seed-store.cjs",
    "deploy:store": "firebase deploy --project club-bzr --only functions:getStoreConfig,functions:browseStore,functions:getStoreListing,functions:saveStoreListing,functions:moderateStoreListing,functions:createStoreUpload,functions:quoteStoreOrder,functions:checkoutStoreOrder,functions:actOnStoreOrder,functions:downloadStoreAsset,functions:getStoreWorkspace,functions:getStoreOrder,functions:messageStoreOrder,functions:getStoreOrderAsset,functions:getStoreSellerSummary,functions:adminStoreSummary,functions:saveStoreSeller,functions:getStoreSeller,functions:adminVerifyStoreSeller,functions:adminUpdateStoreSettings,functions:requestStorePayout,functions:checkStorePayment,functions:checkStorePayout,functions:lencoStoreWebhook,functions:retryStoreFulfilment,functions:recoverStoreOrders,functions:lencoPointsWebhook"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
