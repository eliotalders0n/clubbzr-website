# Server configuration only. Keep real secret values in Secret Manager.
# LENCO_SECRET_KEY is a Firebase Functions secret, not a VITE variable.
# Set the exact sandbox/production v2 API URL confirmed by Lenco.
# LENCO_API_BASE=https://api.lenco.co/access/v2

# Enable only after written marketplace approval for Club BZR's account,
# sandbox sign-off, and appropriate legal/compliance review.
LENCO_MARKETPLACE_APPROVED=false
LENCO_MARKETPLACE_ACCOUNT_ID=

# Leave App Check enabled in deployed environments.
ENFORCE_APP_CHECK=true
